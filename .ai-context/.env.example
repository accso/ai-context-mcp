# .env.example — AI Context environment variables
#
# Copy this file to .env (gitignored) and fill in the values,
# OR export the variables in your shell profile (~/.zshrc / ~/.zprofile).
#
# Most local setups (lmstudio, omlx without auth) do not need any env vars at all.

# ── omlx (optional) ──────────────────────────────────────────────────────────
# omlx runs locally at 127.0.0.1:8000 — no API key is required for a default
# local setup.  Only set OMLX_API_KEY if you have enabled authentication on
# your omlx instance.
#
# OMLX_API_KEY=

# ── Optional overrides ────────────────────────────────────────────────────────
# These are usually read from config.yaml / .resolved.json.
# Only needed if you want to override without touching config.yaml.
#
# OLLAMA_URL=http://localhost:11434

